# Safe configuration template. Inject real credentials through the deployment secret store.
OCR_ENVIRONMENT=development
OCR_PIPELINE_VERSION=0.1.0
OCR_SCHEMA_VERSION=1.0.0
OCR_STORAGE_ROOT=var/artifacts
OCR_EXPORT_STAGING_WORKSPACE=var/tmp/exports
OCR_ARTIFACT_STORE_BACKEND=local
OCR_S3_ENDPOINT_URL=
OCR_S3_PREFIX=ocr
OCR_METADATA_BACKEND=file
# Required only when OCR_METADATA_BACKEND=postgres; inject through a secret store.
OCR_POSTGRES_DSN=
OCR_POSTGRES_SCHEMA=public
OCR_QUEUE_BACKEND=local
# Required only when OCR_QUEUE_BACKEND=redis; inject through a secret store.
OCR_REDIS_URL=
OCR_REDIS_QUEUE_NAME=ocr:jobs
OCR_ALLOW_SENSITIVE_DEBUG_LOGGING=false
OCR_MAX_UPLOAD_BYTES=52428800
OCR_MAX_PAGES=500
OCR_MAX_RENDER_PIXELS=50000000
OCR_MAX_CROP_PIXELS=12000000
OCR_DEFAULT_DPI=300
OCR_HIGH_QUALITY_DPI=450
OCR_TINY_TEXT_DPI=600
OCR_TINY_TEXT_PIXEL_HEIGHT_THRESHOLD=12.0
OCR_PREPROCESSING_PROFILES=clean_print,mobile_photo,low_contrast,tiny_text,handwriting,binary_scan
OCR_DEFAULT_PREPROCESSING_PROFILE=clean_print
OCR_MAX_PREPROCESSING_VARIANTS=8
# Normalization is provenance-bearing; raw OCR text is never changed.
OCR_NORMALIZATION_POLICY_VERSION=1.0.0
OCR_NORMALIZATION_UNICODE_FORM=NFC
OCR_NORMALIZATION_CHARACTER_VARIANTS=true
OCR_NORMALIZATION_DIGIT_POLICY=persian
OCR_NORMALIZATION_REMOVE_TATWEEL=false
OCR_NORMALIZATION_WHITESPACE_POLICY=trim
OCR_NORMALIZATION_LINE_BREAK_POLICY=preserve
OCR_NORMALIZATION_ZERO_WIDTH_POLICY=preserve
OCR_NORMALIZATION_TRIM_LINE_EDGES=true
OCR_MAX_REGION_SCALE=4
OCR_MAX_RETRIES=2
OCR_WORKER_COUNT=2
OCR_MAX_QUEUED_JOBS=100
OCR_DEVICE=auto
OCR_MODEL_LOAD_MODE=lazy
OCR_GPU_INFERENCE_CONCURRENCY=1
OCR_MAX_PAGES_IN_FLIGHT=1
# Mode-specific retry/high-quality policy; values are configuration-hashed.
OCR_MODE_MAX_RETRIES=fast:0,balanced:2,accurate:3
OCR_MODE_HIGH_QUALITY_RETRY=fast:false,balanced:true,accurate:true
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_REQUIRE_AUTH=false
# Required when OCR_REQUIRE_AUTH=true; use a secret manager in staging/production.
OCR_API_KEYS=REPLACE_AT_RUNTIME
# Page/resource safety and native-text inspection policy.
OCR_MAX_PAGE_WIDTH=50000
OCR_MAX_PAGE_HEIGHT=50000
OCR_REGION_SCALE_CANDIDATES=2,3,4
OCR_MAX_REGION_SCALE=4
OCR_VERIFICATION_THRESHOLD=0.92
OCR_VERIFICATION_MAX_CANDIDATES=6
OCR_VERIFICATION_MIN_CONSENSUS_CANDIDATES=2
OCR_VERIFICATION_REQUIRE_CONSENSUS=true
OCR_VERIFICATION_ALLOW_CONSENSUS_OVERRIDE=true
OCR_VERIFICATION_REQUIRE_INDEPENDENT_CONSENSUS=true
# Legacy setting name: the value counts distinct (family, backend, model, version) evidence keys.
OCR_VERIFICATION_MIN_INDEPENDENT_BACKEND_FAMILIES=2
OCR_VERIFICATION_MIN_TEXT_LENGTH=1
OCR_VERIFICATION_MAX_SUSPICIOUS_CHAR_RATE=0.10
OCR_VERIFICATION_MIN_IMAGE_QUALITY=0.20
OCR_VERIFICATION_ENABLE_HIGH_QUALITY_RETRY=true
# Optional backend-specific thresholds; never put credentials here.
OCR_BACKEND_CONFIDENCE_THRESHOLDS=
OCR_PROCESSING_TIMEOUT_SECONDS=300
OCR_NATIVE_TEXT_MIN_CHARACTERS=5
OCR_NATIVE_TEXT_MIN_COVERAGE=0.00001
OCR_NATIVE_TEXT_MAX_SUSPICIOUS_RATIO=0.20
OCR_NATIVE_TEXT_MIN_PLAUSIBILITY=0.50
OCR_TINY_TEXT_LINE_HEIGHT_POINTS=7.0
OCR_ENABLED_OCR_BACKENDS=tesseract
OCR_LANGUAGES=fas,eng
OCR_BACKEND_TIMEOUT_SECONDS=120
OCR_LAYOUT_BACKEND=heuristic
OCR_LAYOUT_MAX_PIXELS=4000000
OCR_LAYOUT_MAX_REGIONS=512
OCR_LAYOUT_MIN_CONFIDENCE=0.35
OCR_HANDWRITING_BACKEND=unavailable
OCR_HANDWRITING_MODEL_PATH=var/models/htr
OCR_TABLE_BACKEND=unavailable
OCR_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/tiff,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,text/plain,text/csv,application/json,text/html
OCR_ARTIFACT_BUCKET=ocr-artifacts
OCR_TEMPORARY_WORKSPACE=var/tmp
OCR_MODEL_PATH=var/models
OCR_CACHE_PATH=var/cache
# Retention windows are seconds. Deletion is explicit and authenticated; automatic
# retention workers remain deployment-specific.
OCR_RETENTION_TEMPORARY_SECONDS=86400
OCR_RETENTION_SOURCE_SECONDS=2592000
OCR_RETENTION_DERIVED_SECONDS=2592000
OCR_RETENTION_VERIFIED_DATASET_SECONDS=31536000
